{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "App": {
    "PublicBaseUrl": "https://nijmitra.com",
    "BootstrapSuperAdminMobiles": []
  },
  "Jwt": {
    "Issuer": "https://nijmitra.com",
    "Audience": "nijmitra-app",
    "SigningKey": "",
    "AccessTokenMinutes": 10
  },
  "Security": {
    "DataEncryptionKey": ""
  },
  "Storage": {
    "RootPath": "App_Data/storage",
    "MalwareScanner": "none",
    "ClamAvHost": "127.0.0.1",
    "ClamAvPort": 3310
  },
  "Database": {
    "AutoMigrate": true
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [ "https://nijmitra.com", "https://www.nijmitra.com" ]
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "GlobalPerMinute": 600
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
